#include "adc.h"


volatile uint16_t adc_raw = 0;
extern volatile uint8_t adc_busy;
static volatile ADC_HandleTypeDef* hadcx;

void ADC_Init(ADC_HandleTypeDef *hadc){
	hadcx = hadc;
}
void HAL_ADCEx_InjectedConvCpltCallback(ADC_HandleTypeDef *hadc)
{
    if (hadc->Instance != ADC1) return;
    adc_raw = (uint16_t)HAL_ADCEx_InjectedGetValue(hadc, ADC_INJECTED_RANK_1);
    adc_busy = 0;
}
